{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["desktop/src/react/*"],
      "@codia/plugin-components": ["packages/plugin-components/src/index.ts"],
      "@codia/plugin-protocol": ["packages/plugin-protocol/src/index.ts"],
      "@codia/plugin-runtime": ["packages/plugin-runtime/src/index.ts"],
      "@codia/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@codia/plugin-components": ["packages/plugin-components/src/index.ts"],
      "@codia/plugin-protocol": ["packages/plugin-protocol/src/index.ts"],
      "@codia/plugin-runtime": ["packages/plugin-runtime/src/index.ts"],
      "@codia/plugin-sdk": ["packages/plugin-sdk/src/index.ts"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "desktop/src/react/**/*.test.ts",
    "desktop/src/react/**/*.test.tsx",
    "desktop/src/assets.d.ts",
    "desktop/src/global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "codia-*",
    "codia-*/**",
    "dist",
    "dist-server",
    "dist-server-bundle",
    "dist-computer-use",
    "dist-sandbox"
  ]
}
