{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["desktop/src/react/*"],
      "@g-sap/plugin-components": ["packages/plugin-components/src/index.ts"],
      "@g-sap/plugin-protocol": ["packages/plugin-protocol/src/index.ts"],
      "@g-sap/plugin-runtime": ["packages/plugin-runtime/src/index.ts"],
      "@g-sap/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@hana/plugin-components": ["packages/plugin-components/src/index.ts"],
      "@hana/plugin-protocol": ["packages/plugin-protocol/src/index.ts"],
      "@hana/plugin-runtime": ["packages/plugin-runtime/src/index.ts"],
      "@hana/plugin-sdk": ["packages/plugin-sdk/src/index.ts"]
    }
  },
  "include": [
    "desktop/src/**/*.ts",
    "desktop/src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "desktop/dist-renderer",
    "openhanako-main1.6",
    "openhanako-main1.6/**",
    "openhanako-*",
    "openhanako-*/**",
    "desktop/src/**/__tests__/**",
    "desktop/src/**/*.test.ts",
    "desktop/src/**/*.test.tsx"
  ]
}
