{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["desktop/src/react/*"],
      "@codia/plugin-components": ["packages/plugin-components/src/index.ts"],
      "@codia/plugin-protocol": ["packages/plugin-protocol/src/index.ts"],
      "@codia/plugin-runtime": ["packages/plugin-runtime/src/index.ts"],
      "@codia/plugin-sdk": ["packages/plugin-sdk/src/index.ts"]
    }
  },
  "include": [
    "desktop/src/**/*.ts",
    "desktop/src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "desktop/dist-renderer",
    "codia-main1.6",
    "codia-main1.6/**",
    "codia-*",
    "codia-*/**",
    "desktop/src/**/__tests__/**",
    "desktop/src/**/*.test.ts",
    "desktop/src/**/*.test.tsx"
  ]
}
